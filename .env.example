# MixLearn Studio — Safe Environment Variable Configuration
# NOTE: Never commit genuine secrets or actual API keys to version control.

# Server-side Gemini API key (Scheduled for Phase 5 consent-gated educational coaching only)
# AI is prohibited from computing, altering, or overriding numerical DSP measurements.
GEMINI_API_KEY=your_gemini_api_key_here

# Maximum audio upload limit in Megabytes (Enforced in Phase 2+ DSP pipelines)
MAX_UPLOAD_MB=150

# Backend service configuration
PORT=8000
HOST=127.0.0.1

# Frontend development host
VITE_PORT=3000
